# Pixel Agents Environment Variables
# Copy this file to .env and uncomment variables as needed.
# .env is gitignored and loaded automatically by the F5 launch config.

# Enable verbose debug logging for hook events (SessionStart, SessionEnd, Stop, etc.)
PIXEL_AGENTS_DEBUG=1

# NVIDIA API Catalog
# Generate a key at https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional override; normally leave this unchanged.
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1


# Local Sales DM Simulator (sandbox only; does not publish to Instagram or charge money)
# Price/shipping values use minor currency units: 149900 = 1,499.00 TRY.
SALES_PRODUCT_SKU=
SALES_PRODUCT_NAME=
SALES_PRODUCT_DESCRIPTION=
SALES_PRODUCT_PRICE_MINOR=
SALES_PRODUCT_CURRENCY=TRY
SALES_PRODUCT_STOCK=
SALES_SHIPPING_MINOR=
